<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#121212" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/btnBack" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="← Back" android:textColor="#FF9800" android:textSize="16sp"/>
            <TextView android:text="Servers" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Servers" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold" android:gravity="center"/>
        </LinearLayout>
        <TextView android:text="Free servers" android:textColor="#888888" android:layout_marginTop="16dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <LinearLayout android:id="@+id/rowSingapore" android:layout_width="match_parent" android:layout_height="64dp" android:background="@drawable/input_bg" android:padding="12dp" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:text="🇸🇬  Singapore" android:textColor="#FFFFFF" android:textStyle="bold" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
            <TextView android:text="42ms • Low latency" android:textColor="#4CAF50" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/rowUSA" android:layout_width="match_parent" android:layout_height="64dp" android:background="@drawable/input_bg" android:padding="12dp" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:text="🇺🇸  USA" android:textColor="#FFFFFF" android:textStyle="bold" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
            <TextView android:text="128ms • Medium" android:textColor="#FFC107" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/rowGermany" android:layout_width="match_parent" android:layout_height="64dp" android:background="@drawable/input_bg" android:padding="12dp" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:text="🇩🇪  Germany" android:textColor="#FFFFFF" android:textStyle="bold" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
            <TextView android:text="95ms • Low latency" android:textColor="#4CAF50" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/rowKenya" android:layout_width="match_parent" android:layout_height="64dp" android:background="@drawable/input_bg" android:padding="12dp" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:text="🇰🇪  Kenya" android:textColor="#FFFFFF" android:textStyle="bold" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
            <TextView android:text="67ms • Low latency" android:textColor="#4CAF50" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/rowUK" android:layout_width="match_parent" android:layout_height="64dp" android:background="@drawable/input_bg" android:padding="12dp" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:text="🇬🇧  UK" android:textColor="#FFFFFF" android:textStyle="bold" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
            <TextView android:text="54ms • Low latency" android:textColor="#4CAF50" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/rowNetherlands" android:layout_width="match_parent" android:layout_height="64dp" android:background="@drawable/input_bg" android:padding="12dp" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:text="🇳🇱  Netherlands" android:textColor="#FFFFFF" android:textStyle="bold" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
            <TextView android:text="88ms • Low latency" android:textColor="#4CAF50" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <TextView android:text="Premium servers" android:textColor="#FFC107" android:layout_marginTop="20dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:background="@drawable/input_bg" android:padding="12dp" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:text="👑  Premium - All Countries" android:textColor="#FFC107" android:textStyle="bold" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
            <TextView android:text="Unlock" android:textColor="#FF9800" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
