<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F1A"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="eProVPN"
            android:textColor="#00E676"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fast • Secure • Unlimited"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SELECT MODE" android:textColor="#00E676" android:textStyle="bold" android:textSize="13sp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
            <Button android:id="@+id/btnHttpProxy" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="HTTP Proxy" android:textSize="11sp" android:backgroundTint="#1E2A3A" android:textColor="#FFFFFF" />
            <Button android:id="@+id/btnSshTls" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="SSH/TLS" android:textSize="11sp" android:backgroundTint="#1E2A3A" android:textColor="#FFFFFF" />
            <Button android:id="@+id/btnSslProxy" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="SSL PROXY" android:textSize="11sp" android:backgroundTint="#1E2A3A" android:textColor="#FFFFFF" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
            <Button android:id="@+id/btnV2ray" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="V2RAY" android:textSize="11sp" android:backgroundTint="#1E2A3A" android:textColor="#FFFFFF" />
            <Button android:id="@+id/btnHysteria" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="HYSTERIA" android:textSize="11sp" android:backgroundTint="#1E2A3A" android:textColor="#FFFFFF" />
            <Button android:id="@+id/btnPsiphon" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="PSIPHON" android:textSize="11sp" android:backgroundTint="#1E2A3A" android:textColor="#FFFFFF" />
            <Button android:id="@+id/btnShadowsocks" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="SHADOW" android:textSize="11sp" android:backgroundTint="#1E2A3A" android:textColor="#FFFFFF" />
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SERVER SETTINGS" android:textColor="#00E676" android:textStyle="bold" android:textSize="13sp" android:layout_marginTop="20dp" />

        <EditText android:id="@+id/etServer" android:layout_width="match_parent" android:layout_height="50dp" android:hint="Server Host" android:text="sg1.eprovpn.com" android:textColor="#FFFFFF" android:textColorHint="#888888" android:background="#1E2A3A" android:padding="12dp" android:layout_marginTop="8dp" />
        <EditText android:id="@+id/etPort" android:layout_width="match_parent" android:layout_height="50dp" android:hint="Port" android:text="443" android:inputType="number" android:textColor="#FFFFFF" android:textColorHint="#888888" android:background="#1E2A3A" android:padding="12dp" android:layout_marginTop="8dp" />

        <LinearLayout android:id="@+id/layoutUserPass" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <EditText android:id="@+id/etUsername" android:layout_width="match_parent" android:layout_height="50dp" android:hint="Username" android:textColor="#FFFFFF" android:textColorHint="#888888" android:background="#1E2A3A" android:padding="12dp" android:layout_marginTop="8dp" />
            <EditText android:id="@+id/etPassword" android:layout_width="match_parent" android:layout_height="50dp" android:hint="Password" android:inputType="textPassword" android:textColor="#FFFFFF" android:textColorHint="#888888" android:background="#1E2A3A" android:padding="12dp" android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/layoutPayload" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <EditText android:id="@+id/etPayload" android:layout_width="match_parent" android:layout_height="90dp" android:hint="Payload" android:gravity="top" android:textColor="#FFFFFF" android:textColorHint="#888888" android:background="#1E2A3A" android:padding="12dp" android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/layoutSni" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <EditText android:id="@+id/etSni" android:layout_width="match_parent" android:layout_height="50dp" android:hint="SNI / Bug Host" android:textColor="#FFFFFF" android:textColorHint="#888888" android:background="#1E2A3A" android:padding="12dp" android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/layoutRemote" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <EditText android:id="@+id/etRemoteProxy" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="2" android:hint="Remote Proxy" android:textColor="#FFFFFF" android:textColorHint="#888888" android:background="#1E2A3A" android:padding="12dp" android:layout_marginTop="8dp" />
            <EditText android:id="@+id/etRemotePort" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:hint="Port" android:inputType="number" android:textColor="#FFFFFF" android:textColorHint="#888888" android:background="#1E2A3A" android:padding="12dp" android:layout_marginTop="8dp" android:layout_marginStart="8dp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/layoutUuid" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <EditText android:id="@+id/etUuid" android:layout_width="match_parent" android:layout_height="50dp" android:hint="UUID" android:textColor="#FFFFFF" android:textColorHint="#888888" android:background="#1E2A3A" android:padding="12dp" android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/layoutVless" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <EditText android:id="@+id/etVlessLink" android:layout_width="match_parent" android:layout_height="90dp" android:hint="Paste VLESS / VMESS Link" android:gravity="top" android:textColor="#FFFFFF" android:textColorHint="#888888" android:background="#1E2A3A" android:padding="12dp" android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/layoutSsMethod" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <EditText android:id="@+id/etSsMethod" android:layout_width="match_parent" android:layout_height="50dp" android:hint="Method: aes-256-gcm" android:text="aes-256-gcm" android:textColor="#FFFFFF" android:textColorHint="#888888" android:background="#1E2A3A" android:padding="12dp" android:layout_marginTop="8dp" />
        </LinearLayout>

        <Button android:id="@+id/btnConnect" android:layout_width="match_parent" android:layout_height="58dp" android:text="CONNECT" android:textSize="18sp" android:textStyle="bold" android:backgroundTint="#00E676" android:textColor="#000000" android:layout_marginTop="20dp" />

        <TextView android:id="@+id/tvLog" android:layout_width="match_parent" android:layout_height="150dp" android:text="Log..." android:textColor="#00FF00" android:textSize="11sp" android:background="#111111" android:padding="10dp" android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>
