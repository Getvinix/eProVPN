<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#121212" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/btnServers" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Servers" android:textColor="#FF9800" android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:text="eProVPN" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold"/>
            <TextView android:id="@+id/btnPremium" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Premium" android:textColor="#FFC107" android:textSize="14sp" android:gravity="end"/>
        </LinearLayout>

        <!-- MODES SCROLL -->
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/btnHttpProxy" android:layout_width="wrap_content" android:layout_height="40dp" android:text="HTTP Proxy" android:backgroundTint="#FF9800" android:textColor="#FFFFFF"/>
                <Button android:id="@+id/btnSshTls" android:layout_width="wrap_content" android:layout_height="40dp" android:text="SSH/TLS" android:backgroundTint="#2A2A2A" android:textColor="#AAAAAA" android:layout_marginStart="6dp"/>
                <Button android:id="@+id/btnSslProxy" android:layout_width="wrap_content" android:layout_height="40dp" android:text="SSL/TLS Proxy" android:backgroundTint="#2A2A2A" android:textColor="#AAAAAA" android:layout_marginStart="6dp"/>
                <Button android:id="@+id/btnV2ray" android:layout_width="wrap_content" android:layout_height="40dp" android:text="V2Ray/Xray" android:backgroundTint="#2A2A2A" android:textColor="#AAAAAA" android:layout_marginStart="6dp"/>
                <Button android:id="@+id/btnHysteria" android:layout_width="wrap_content" android:layout_height="40dp" android:text="Hysteria" android:backgroundTint="#2A2A2A" android:textColor="#AAAAAA" android:layout_marginStart="6dp"/>
                <Button android:id="@+id/btnPsiphon" android:layout_width="wrap_content" android:layout_height="40dp" android:text="Psiphon" android:backgroundTint="#2A2A2A" android:textColor="#AAAAAA" android:layout_marginStart="6dp"/>
                <Button android:id="@+id/btnShadowsocks" android:layout_width="wrap_content" android:layout_height="40dp" android:text="Shadowsocks" android:backgroundTint="#2A2A2A" android:textColor="#AAAAAA" android:layout_marginStart="6dp"/>
            </LinearLayout>
        </HorizontalScrollView>

        <TextView android:text="Server" android:textColor="#FFFFFF" android:layout_marginTop="16dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/etServer" android:layout_width="match_parent" android:layout_height="48dp" android:text="sg1.eprovpn.com" android:textColor="#FFFFFF" android:background="@drawable/input_bg" android:padding="10dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginEnd="8dp">
                <TextView android:text="Port" android:textColor="#FFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <EditText android:id="@+id/etPort" android:layout_width="match_parent" android:layout_height="48dp" android:text="443" android:textColor="#FFFFFF" android:background="@drawable/input_bg" android:padding="10dp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/layoutSsMethod" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:text="Method" android:textColor="#FFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <EditText android:id="@+id/etSsMethod" android:layout_width="match_parent" android:layout_height="48dp" android:text="aes-256-gcm" android:textColor="#FFFFFF" android:background="@drawable/input_bg" android:padding="10dp"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/layoutUserPass" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:text="Username" android:textColor="#FFFFFF" android:layout_marginTop="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <EditText android:id="@+id/etUsername" android:layout_width="match_parent" android:layout_height="48dp" android:text="your_username" android:textColor="#FFFFFF" android:background="@drawable/input_bg" android:padding="10dp"/>
            <TextView android:text="Password" android:textColor="#FFFFFF" android:layout_marginTop="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <EditText android:id="@+id/etPassword" android:layout_width="match_parent" android:layout_height="48dp" android:hint="Password" android:textColor="#FFFFFF" android:inputType="textPassword" android:background="@drawable/input_bg" android:padding="10dp"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/layoutPayload" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:text="Payload" android:textColor="#FFFFFF" android:layout_marginTop="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <EditText android:id="@+id/etPayload" android:layout_width="match_parent" android:layout_height="80dp" android:text="GET / HTTP/1.1" android:textColor="#FFFFFF" android:background="@drawable/input_bg" android:padding="10dp" android:gravity="top"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/layoutSni" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:text="SNI / Bug Host" android:textColor="#FFFFFF" android:layout_marginTop="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <EditText android:id="@+id/etSni" android:layout_width="match_parent" android:layout_height="48dp" android:text="example.com" android:textColor="#FFFFFF" android:background="@drawable/input_bg" android:padding="10dp"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/layoutUuid" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:text="UUID / Auth Password" android:textColor="#FFFFFF" android:layout_marginTop="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <EditText android:id="@+id/etUuid" android:layout_width="match_parent" android:layout_height="48dp" android:hint="UUID" android:textColor="#FFFFFF" android:background="@drawable/input_bg" android:padding="10dp"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/layoutVless" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:text="VLESS / VMess Link" android:textColor="#FFFFFF" android:layout_marginTop="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <EditText android:id="@+id/etVlessLink" android:layout_width="match_parent" android:layout_height="48dp" android:hint="vless://..." android:textColor="#FFFFFF" android:background="@drawable/input_bg" android:padding="10dp"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/layoutRemote" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:text="REMOTE PROXY" android:textColor="#888888" android:gravity="center" android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                <EditText android:id="@+id/etRemoteProxy" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="127.0.0.1" android:gravity="center" android:textColor="#FFFFFF" android:background="@drawable/input_bg" android:layout_marginEnd="8dp"/>
                <EditText android:id="@+id/etRemotePort" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="8080" android:gravity="center" android:textColor="#FFFFFF" android:background="@drawable/input_bg"/>
            </LinearLayout>
        </LinearLayout>

        <TextView android:text="SERVER LIST" android:textColor="#888888" android:gravity="center" android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <LinearLayout android:id="@+id/serverSingapore" android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:background="@drawable/input_bg" android:padding="10dp" android:layout_marginTop="8dp" android:gravity="center_vertical">
            <TextView android:text="Singapore" android:textColor="#FFFFFF" android:textStyle="bold" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
            <TextView android:text="sg1.eprovpn.com • 42ms" android:textColor="#AAAAAA" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/serverUSA" android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:background="@drawable/input_bg" android:padding="10dp" android:layout_marginTop="8dp" android:gravity="center_vertical">
            <TextView android:text="USA" android:textColor="#FFFFFF" android:textStyle="bold" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
            <TextView android:text="us2.eprovpn.com • 128ms" android:textColor="#AAAAAA" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/serverGermany" android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:background="@drawable/input_bg" android:padding="10dp" android:layout_marginTop="8dp" android:gravity="center_vertical">
            <TextView android:text="Germany" android:textColor="#FFFFFF" android:textStyle="bold" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
            <TextView android:text="de3.eprovpn.com • 95ms" android:textColor="#AAAAAA" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <TextView android:text="CONNECTION LOG" android:textColor="#888888" android:gravity="center" android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/tvLog" android:layout_width="match_parent" android:layout_height="110dp" android:background="#1E1E1E" android:textColor="#4CAF50" android:textSize="12sp" android:padding="10dp" android:layout_marginTop="8dp"/>

        <Button android:id="@+id/btnConnect" android:layout_width="match_parent" android:layout_height="56dp" android:text="CONNECT" android:textSize="20sp" android:textStyle="bold" android:backgroundTint="#FF9800" android:textColor="#FFFFFF" android:layout_marginTop="16dp"/>
    </LinearLayout>
</ScrollView>
